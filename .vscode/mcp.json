{
	"inputs": [
		{
			"id": "CONTEXT7_API_KEY",
			"type": "promptString",
			"description": "API key for authentication",
			"password": true
		},
		{
			"id": "token",
			"type": "promptString",
			"description": "",
			"password": true
		}
	],
	"servers": {
		"engenharia-local": {
			"command": "npm",
			"args": [
				"run",
				"mcp:server"
			],
			"type": "stdio"
		},
		"sequential-thinking": {
			"command": "npx",
			"args": [
				"--no-install",
				"mcp-server-sequential-thinking"
			],
			"type": "stdio"
		},
		"context7": {
			"command": "npx",
			"args": [
				"--no-install",
				"@upstash/context7-mcp",
				"--api-key",
				"${input:CONTEXT7_API_KEY}"
			],
			"type": "stdio"
		}
	}
}