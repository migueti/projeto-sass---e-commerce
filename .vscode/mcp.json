{
	"inputs": [
		{
			"id": "SENTRY_ACCESS_TOKEN",
			"type": "promptString",
			"description": "Your Sentry user authentication token",
			"password": true
		},
		{
			"id": "OBSIDIAN_MCP_TOKEN",
			"type": "promptString",
			"description": "Token de autenticação do Obsidian MCP Server",
			"password": true
		}
	],
	"servers": {
		"sequential-thinking": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-sequential-thinking"
			],
			"type": "stdio"
		},
		"obsidian": {
			"type": "http",
			"url": "https://repair-wrench-racing.ngrok-free.dev/mcp",
			"headers": {
				"Authorization": "Bearer ${input:OBSIDIAN_MCP_TOKEN}"
			}
		},
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp"
		}
	}
}