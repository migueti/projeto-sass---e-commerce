# Relative SQLite paths are resolved from the prisma directory.
DATABASE_URL="file:./dev.db"

# Generate a different value for every environment. Never commit the real secret.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Use the actual public URL in a deployed environment.
NEXTAUTH_URL="http://localhost:3000"
# Public HTTPS URL used by Mercado Pago for callbacks and return URLs.
APP_URL=""
ADMIN_EMAIL="admin@example.com"

# Mercado Pago Checkout Pro. Keep this token on the server only.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
# Use true only with a TEST- token and false/empty with an APP_USR- token.
MERCADOPAGO_USE_SANDBOX="true"
NUVEM_PLAN_PRICE="29.90"

# Comma-separated hostnames accepted by Server Actions behind a reverse proxy.
# Example: app.example.com,preview.example.com
SERVER_ACTION_ALLOWED_ORIGINS=""

# Sentry DSNs are public client identifiers; use separate values per environment when needed.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
